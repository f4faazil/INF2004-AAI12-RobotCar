CC ?= cc
CFLAGS = -std=c11 -O2 -Wall -Wextra -Werror -pedantic

.PHONY: test clean

test: test_mqtt_mailbox
	./test_mqtt_mailbox

test_mqtt_mailbox: test_mqtt_mailbox.c ../app_program/mqtt_mailbox.c ../app_program/mqtt_mailbox.h
	$(CC) $(CFLAGS) -o $@ test_mqtt_mailbox.c ../app_program/mqtt_mailbox.c

clean:
	rm -f test_mqtt_mailbox
