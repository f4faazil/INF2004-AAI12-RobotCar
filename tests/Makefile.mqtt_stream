CC ?= cc
CFLAGS = -std=c11 -O2 -Wall -Wextra -Werror -pedantic

.PHONY: test clean

test: test_mqtt_stream
	./test_mqtt_stream

test_mqtt_stream: test_mqtt_stream.c ../app_program/mqtt_stream.c ../app_program/mqtt_stream.h
	$(CC) $(CFLAGS) -o $@ test_mqtt_stream.c ../app_program/mqtt_stream.c

clean:
	rm -f test_mqtt_stream
