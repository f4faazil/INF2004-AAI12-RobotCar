CC ?= cc
CFLAGS = -std=c11 -O2 -Wall -Wextra -Werror -pedantic

.PHONY: test clean

test: test_mqtt_wire
	./test_mqtt_wire

test_mqtt_wire: test_mqtt_wire.c ../app_program/mqtt_wire.c ../app_program/mqtt_wire.h
	$(CC) $(CFLAGS) -o $@ test_mqtt_wire.c ../app_program/mqtt_wire.c

clean:
	rm -f test_mqtt_wire
