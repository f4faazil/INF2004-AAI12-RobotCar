# Browser/backend
PORT=3000
DEMO_MODE=false

# MQTT connection. Keep the real .env file local; it is ignored by Git.
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=aai12-dashboard

# Topics confirmed in the current firmware
MQTT_TEST_TOPIC=aai12/test
MQTT_DIAGNOSTIC_TOPIC=aai12/diagnostic
MQTT_TELEMETRY_TOPIC=aai12/robot/telemetry
MQTT_HEARTBEAT_TOPIC=aai12/robot/heartbeat

# Optional future JSON telemetry topic (not currently published by firmware).
# Expected fields are documented in README.md. Leave blank until agreed.
MQTT_JSON_TOPIC=
